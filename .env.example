# Directus CMS
NUXT_PUBLIC_DIRECTUS_URL=https://cms.espressos.work
# Server-side token used to read content and create testimonial submissions.
# Use a static token for a role with the minimum permissions needed (not an admin token).
NUXT_DIRECTUS_TOKEN=

# Public URL of this site — used for canonical links, sitemap and RSS.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the PreMID extension sends (Authorization: Bearer <secret> or ?token=<secret>).
# When empty, anyone can update the "now playing" pill.
NUXT_PREMID_SECRET=
